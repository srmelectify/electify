{
  "name": "electify-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "concurrently -n \"web,api\" -c \"blue,magenta\" \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace=@electify/web",
    "dev:api": "npm run dev --workspace=@electify/api",
    "build": "npm run build --workspace=@electify/web && npm run build --workspace=@electify/api",
    "build:web": "npm run build --workspace=@electify/web",
    "build:api": "npm run build --workspace=@electify/api",
    "start:web": "npm run start --workspace=@electify/web",
    "start:api": "npm run start:prod --workspace=@electify/api",
    "lint": "npm run lint --workspace=@electify/web",
    "typecheck": "npm run typecheck --workspace=@electify/web && npm run typecheck --workspace=@electify/api",
    "db:generate": "npm run db:generate --workspace=@electify/db",
    "db:migrate": "npm run db:migrate --workspace=@electify/db",
    "db:push": "npm run db:push --workspace=@electify/db",
    "db:seed": "npm run db:seed --workspace=@electify/db",
    "db:reset": "npm run db:reset --workspace=@electify/db",
    "test": "npm run test --workspace=@electify/web",
    "test:unit": "npm run test:unit --workspace=@electify/web",
    "test:e2e": "npm run test:e2e --workspace=@electify/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "turbo": "^2.4.4"
  }
}
